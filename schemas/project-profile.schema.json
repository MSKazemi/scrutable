{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MSKazemi/mohsen/blob/main/schemas/project-profile.schema.json",
  "title": "Product Questionbook project profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id", "name", "subject", "lifecycle_stage", "owners",
    "created_at", "graph_revision"
  ],
  "properties": {
    "project_id": { "type": "string", "minLength": 2 },
    "name": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "description", "in_scope", "out_of_scope"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "application", "service", "feature", "product", "platform",
            "framework", "ai_agent", "integration", "robot_connected_system",
            "process", "organization", "subsystem"
          ]
        },
        "description": { "type": "string" },
        "in_scope": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } }
      }
    },
    "lifecycle_stage": {
      "type": "string",
      "enum": ["discover", "define", "design", "build", "verify", "release", "operate", "evolve", "retire"]
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "name"],
        "properties": {
          "role": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "graph_revision": { "type": "integer", "minimum": 1 }
  }
}
