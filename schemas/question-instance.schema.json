{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MSKazemi/scrutable/blob/main/schemas/question-instance.schema.json",
  "title": "Scrutable question instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "project_id", "subject_id", "question_id", "state",
    "priority", "history"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "project_id": { "type": "string", "minLength": 2 },
    "subject_id": { "type": "string", "minLength": 2 },
    "question_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+){2,}$"
    },
    "template_version": { "type": "integer", "minimum": 1 },
    "state": {
      "type": "string",
      "enum": [
        "dormant", "ready", "asked", "answered", "clarification_required",
        "blocked", "verified", "stale", "not_applicable"
      ]
    },
    "owner": { "type": ["string", "null"] },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact", "uncertainty", "unlock_value", "urgency", "cost"],
      "properties": {
        "impact": { "$ref": "#/$defs/score" },
        "uncertainty": { "$ref": "#/$defs/score" },
        "unlock_value": { "$ref": "#/$defs/score" },
        "urgency": { "$ref": "#/$defs/score" },
        "cost": { "$ref": "#/$defs/score" },
        "computed_score": { "type": "number", "minimum": 0 },
        "override_reason": { "type": "string" }
      }
    },
    "answer_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "not_applicable_reason": { "type": "string" },
    "blocked_reason": { "type": "string" },
    "review_due_at": { "type": ["string", "null"], "format": "date-time" },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "at", "actor", "reason"],
        "properties": {
          "from": { "type": ["string", "null"] },
          "to": { "type": "string" },
          "at": { "type": "string", "format": "date-time" },
          "actor": { "type": "string" },
          "reason": { "type": "string" },
          "trigger_id": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "score": { "type": "integer", "minimum": 1, "maximum": 5 }
  }
}

