{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MSKazemi/scrutable/blob/main/schemas/prose-coverage.schema.json",
  "title": "Scrutable prose-to-catalog coverage manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_version",
    "source_revision",
    "mapping_method",
    "scope",
    "summary",
    "coverage_definitions",
    "groups"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_version": { "type": "integer", "minimum": 1 },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "mapping_method": {
      "const": "section_many_to_many_with_preserved_source_text"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inclusion_rule", "exclusions", "source_paths"],
      "properties": {
        "inclusion_rule": { "type": "string", "minLength": 10 },
        "exclusions": {
          "type": "array",
          "items": { "type": "string", "minLength": 5 }
        },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^docs/.+\\.md$" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_numbered_questions",
        "exact",
        "compressed",
        "unmodeled",
        "guidance_only",
        "mapping_groups"
      ],
      "properties": {
        "total_numbered_questions": { "type": "integer", "minimum": 1 },
        "exact": { "type": "integer", "minimum": 0 },
        "compressed": { "type": "integer", "minimum": 0 },
        "unmodeled": { "type": "integer", "minimum": 0 },
        "guidance_only": { "type": "integer", "minimum": 0 },
        "mapping_groups": { "type": "integer", "minimum": 1 }
      }
    },
    "coverage_definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact", "compressed", "unmodeled", "guidance_only"],
      "properties": {
        "exact": { "type": "string", "minLength": 10 },
        "compressed": { "type": "string", "minLength": 10 },
        "unmodeled": { "type": "string", "minLength": 10 },
        "guidance_only": { "type": "string", "minLength": 10 }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    }
  },
  "$defs": {
    "questionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+){2,}$"
    },
    "sourceQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_label", "source_text"],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^docs/.+\\.md::[a-z0-9-]+::[a-z0-9]+$"
        },
        "source_label": { "type": "string", "pattern": "^(?:[A-Z][0-9]+|[0-9]+)$" },
        "source_text": { "type": "string", "minLength": 10, "pattern": "\\?$" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "section",
        "section_anchor",
        "coverage",
        "mapping_mode",
        "catalog_ids",
        "rationale",
        "questions"
      ],
      "properties": {
        "source_path": { "type": "string", "pattern": "^docs/.+\\.md$" },
        "section": { "type": "string", "minLength": 2 },
        "section_anchor": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "coverage": {
          "type": "string",
          "enum": ["exact", "compressed", "unmodeled", "guidance_only"]
        },
        "mapping_mode": { "const": "section_many_to_many" },
        "catalog_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/questionId" }
        },
        "rationale": { "type": "string", "minLength": 10 },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceQuestion" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": { "enum": ["exact", "compressed"] }
            },
            "required": ["coverage"]
          },
          "then": {
            "properties": {
              "catalog_ids": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
